/srv/logs/inctrak/api/access.log
/srv/logs/inctrak/api/errors.log {
    daily
    rotate 14
    missingok
    compress
    delaycompress
    notifempty
    copytruncate
    su root root
    create 0644 root root
}

/srv/logs/inctrak/postgres/postgresql.log {
    daily
    rotate 14
    missingok
    compress
    delaycompress
    notifempty
    copytruncate
}
